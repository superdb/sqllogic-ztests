# Failed due to: https://github.com/superdb/super/issues/6549
script: |
  super -i parquet -f tsv -I q2160.sql | sort > q2160.out

inputs:
  - name: q2160.sql
    data: |
      SELECT (SELECT count(*) FROM t1 AS x WHERE x.b<t1.b),
      a,
      a+b*2+c*3
      FROM t1
      WHERE (e>a AND e<b)
      AND c BETWEEN b-2 AND d+2;
  - name: t1

outputs:
  - name: q2160.out
    data: |
      21	220	1338
      26	245	1484
