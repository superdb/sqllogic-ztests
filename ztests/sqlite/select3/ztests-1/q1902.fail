# Failed due to: https://github.com/superdb/super/issues/6549
script: |
  super -i parquet -f tsv -I q1902.sql | sort > q1902.out

inputs:
  - name: q1902.sql
    data: |
      SELECT a+b*2+c*3,
      (SELECT count(*) FROM t1 AS x WHERE x.b<t1.b),
      c-d,
      CASE a+1 WHEN b THEN 111 WHEN c THEN 222
      WHEN d THEN 333  WHEN e THEN 444 ELSE 555 END
      FROM t1
      WHERE (a>b-2 AND a<b+2)
      AND d NOT BETWEEN 110 AND 150;
  - name: t1

outputs:
  - name: q1902.out
    data: |
      1096	14	1	333
      1180	17	-1	555
      1360	22	-1	555
