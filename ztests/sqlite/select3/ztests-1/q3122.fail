# Failed due to: https://github.com/superdb/super/issues/6549
script: |
  super -i parquet -f tsv -I q3122.sql | sort > q3122.out

inputs:
  - name: q3122.sql
    data: |
      SELECT (SELECT count(*) FROM t1 AS x WHERE x.b<t1.b),
      a+b*2+c*3+d*4,
      CASE a+1 WHEN b THEN 111 WHEN c THEN 222
      WHEN d THEN 333  WHEN e THEN 444 ELSE 555 END,
      (SELECT count(*) FROM t1 AS x WHERE x.c>t1.c AND x.d<t1.d)
      FROM t1
      WHERE b>c
      AND (c<=d-2 OR c>=d+2)
      AND (e>c OR e<d);
  - name: t1

outputs:
  - name: q3122.out
    data: |
      20	2165	333	0
      23	2323	555	0
      3	1272	333	0
