# Failed due to: https://github.com/superdb/super/issues/6549
script: |
  super -i parquet -f tsv -I q2503.sql | sort > q2503.out

inputs:
  - name: q2503.sql
    data: |
      SELECT CASE a+1 WHEN b THEN 111 WHEN c THEN 222
      WHEN d THEN 333  WHEN e THEN 444 ELSE 555 END,
      abs(b-c),
      (SELECT count(*) FROM t1 AS x WHERE x.c>t1.c AND x.d<t1.d),
      a+b*2+c*3+d*4,
      a+b*2+c*3+d*4+e*5
      FROM t1
      WHERE (a>b-2 AND a<b+2)
      AND c BETWEEN b-2 AND d+2
      AND (e>c OR e<d)
      ORDER BY 4,5;
  - name: t1

outputs:
  - name: q2503.out
    data: |
      111	2	0	1371	2046
      111	2	0	1411	2131
      333	3	0	1828	2728
      444	4	0	1325	1985
