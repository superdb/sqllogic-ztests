# Failed due to: https://github.com/superdb/super/issues/6549
script: |
  super -i parquet -f tsv -I q1671.sql | sort > q1671.out

inputs:
  - name: q1671.sql
    data: |
      SELECT CASE WHEN a<b-3 THEN 111 WHEN a<=b THEN 222
      WHEN a<b+3 THEN 333 ELSE 444 END,
      a+b*2+c*3,
      (SELECT count(*) FROM t1 AS x WHERE x.b<t1.b)
      FROM t1
      WHERE (e>a AND e<b)
      OR d NOT BETWEEN 110 AND 150
      ORDER BY 3,1;
  - name: t1

outputs:
  - name: q1671.out
    data: |
      111	1484	26
      222	1158	16
      222	1297	20
      222	1338	21
      333	1096	14
      333	1121	15
      333	1180	17
      333	1277	19
      333	1360	22
      333	1391	23
      333	635	0
      444	1030	12
      444	966	10
      444	NULL	0
      444	NULL	0
      444	NULL	18
      444	NULL	24
