# Failed due to: https://github.com/superdb/super/issues/6549
script: |
  super -i parquet -f tsv -I q859.sql | sort > q859.out

inputs:
  - name: q859.sql
    data: |
      SELECT e,
      a+b*2+c*3,
      abs(a),
      CASE WHEN a<b-3 THEN 111 WHEN a<=b THEN 222
      WHEN a<b+3 THEN 333 ELSE 444 END
      FROM t1
      WHERE EXISTS(SELECT 1 FROM t1 AS x WHERE x.b<t1.b)
      AND a>b
      AND e+d BETWEEN a+b-10 AND c+130
      ORDER BY 3,4,1;
  - name: t1

outputs:
  - name: q859.out
    data: |
