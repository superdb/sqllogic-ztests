# Failed due to: https://github.com/superdb/super/issues/6549
script: |
  super -i parquet -f tsv -I q768.sql | sort > q768.out

inputs:
  - name: q768.sql
    data: |
      SELECT CASE WHEN c>(SELECT avg(c) FROM t1) THEN a*2 ELSE b*10 END,
      a+b*2+c*3
      FROM t1
      WHERE (c<=d-2 OR c>=d+2)
      AND EXISTS(SELECT 1 FROM t1 AS x WHERE x.b<t1.b);
  - name: t1

outputs:
  - name: q768.out
    data: |
      1290	760
      1600	966
      376	1121
      382	1158
      426	1277
      432	1297
      440	1338
      468	1391
