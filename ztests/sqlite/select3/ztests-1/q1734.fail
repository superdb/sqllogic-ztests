# Failed due to: https://github.com/superdb/super/issues/6549
script: |
  super -i parquet -f tsv -I q1734.sql | sort > q1734.out

inputs:
  - name: q1734.sql
    data: |
      SELECT (SELECT count(*) FROM t1 AS x WHERE x.c>t1.c AND x.d<t1.d),
      a+b*2,
      c,
      d,
      e
      FROM t1
      WHERE b>c
      AND (c<=d-2 OR c>=d+2)
      AND c BETWEEN b-2 AND d+2;
  - name: t1

outputs:
  - name: q1734.out
    data: |
      0	698	231	233	230
