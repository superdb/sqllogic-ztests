# Failed due to: https://github.com/superdb/super/issues/6549
script: |
  super -i parquet -f tsv -I q2589.sql | sort > q2589.out

inputs:
  - name: q2589.sql
    data: |
      SELECT a+b*2+c*3+d*4+e*5,
      e,
      (SELECT count(*) FROM t1 AS x WHERE x.b<t1.b),
      c-d,
      a-b
      FROM t1
      WHERE c>d
      AND b>c
      ORDER BY 1,4,3,2;
  - name: t1

outputs:
  - name: q2589.out
    data: |
      2046	135	5	1	-1
      2131	144	6	1	-1
      2878	192	16	3	-3
      NULL	NULL	2	1	-3
