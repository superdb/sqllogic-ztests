# Failed due to: https://github.com/superdb/super/issues/6549
script: |
  super -i parquet -f tsv -I q2423.sql | sort > q2423.out

inputs:
  - name: q2423.sql
    data: |
      SELECT b-c,
      d,
      a+b*2+c*3+d*4+e*5,
      (a+b+c+d+e)/5,
      a+b*2,
      (SELECT count(*) FROM t1 AS x WHERE x.c>t1.c AND x.d<t1.d),
      a-b
      FROM t1
      WHERE (c<=d-2 OR c>=d+2)
      AND d NOT BETWEEN 110 AND 150
      AND b>c
      ORDER BY 4,1,5,6,2;
  - name: t1

outputs:
  - name: q2423.out
    data: |
      1	190	2878	192	579	0	-3
      1	233	3473	232	698	0	2
      3	217	3260	217	652	0	-2
