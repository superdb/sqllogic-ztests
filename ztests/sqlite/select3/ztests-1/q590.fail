# Failed due to: https://github.com/superdb/super/issues/6549
script: |
  super -i parquet -f tsv -I q590.sql | sort > q590.out

inputs:
  - name: q590.sql
    data: |
      SELECT CASE WHEN c>(SELECT avg(c) FROM t1) THEN a*2 ELSE b*10 END,
      (SELECT count(*) FROM t1 AS x WHERE x.b<t1.b),
      (SELECT count(*) FROM t1 AS x WHERE x.c>t1.c AND x.d<t1.d),
      d
      FROM t1
      WHERE (e>c OR e<d)
      AND b>c
      AND c>d;
  - name: t1

outputs:
  - name: q590.out
    data: |
      1390	5	0	136
      1430	6	0	140
