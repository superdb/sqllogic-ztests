# Failed due to: https://github.com/superdb/super/issues/6549
script: |
  super -i parquet -f tsv -I q3279.sql | sort > q3279.out

inputs:
  - name: q3279.sql
    data: |
      SELECT c-d,
      b-c,
      a,
      a+b*2+c*3
      FROM t1
      WHERE c>d
      AND EXISTS(SELECT 1 FROM t1 AS x WHERE x.b<t1.b)
      AND e+d BETWEEN a+b-10 AND c+130
      ORDER BY 3,4;
  - name: t1

outputs:
  - name: q3279.out
    data: |
