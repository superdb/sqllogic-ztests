# Failed due to: https://github.com/superdb/super/issues/6549
script: |
  super -i parquet -f tsv -I q3255.sql | sort > q3255.out

inputs:
  - name: q3255.sql
    data: |
      SELECT CASE a+1 WHEN b THEN 111 WHEN c THEN 222
      WHEN d THEN 333  WHEN e THEN 444 ELSE 555 END,
      (a+b+c+d+e)/5,
      (SELECT count(*) FROM t1 AS x WHERE x.b<t1.b),
      a,
      e
      FROM t1
      WHERE (e>a AND e<b)
      AND e+d BETWEEN a+b-10 AND c+130
      ORDER BY 2,3,5;
  - name: t1

outputs:
  - name: q3255.out
    data: |
