# Failed due to: https://github.com/superdb/super/issues/6549
script: |
  super -i parquet -f tsv -I q1658.sql | sort > q1658.out

inputs:
  - name: q1658.sql
    data: |
      SELECT (SELECT count(*) FROM t1 AS x WHERE x.b<t1.b),
      (SELECT count(*) FROM t1 AS x WHERE x.c>t1.c AND x.d<t1.d)
      FROM t1
      WHERE (c<=d-2 OR c>=d+2)
      AND a>b;
  - name: t1

outputs:
  - name: q1658.out
    data: |
      0	0
      10	0
      15	0
      19	0
      23	0
