# Failed due to: https://github.com/superdb/super/issues/6549
script: |
  super -i parquet -f tsv -I q189.sql | sort > q189.out

inputs:
  - name: q189.sql
    data: |
      SELECT c,
      (SELECT count(*) FROM t1 AS x WHERE x.c>t1.c AND x.d<t1.d),
      CASE a+1 WHEN b THEN 111 WHEN c THEN 222
      WHEN d THEN 333  WHEN e THEN 444 ELSE 555 END,
      a+b*2+c*3+d*4,
      abs(b-c)
      FROM t1
      WHERE (e>a AND e<b)
      AND c BETWEEN b-2 AND d+2
      AND e+d BETWEEN a+b-10 AND c+130
      ORDER BY 3,2;
  - name: t1

outputs:
  - name: q189.out
    data: |
