# Failed due to: https://github.com/superdb/super/issues/6549
script: |
  super -i parquet -f tsv -I q2290.sql | sort > q2290.out

inputs:
  - name: q2290.sql
    data: |
      SELECT abs(b-c),
      (SELECT count(*) FROM t1 AS x WHERE x.b<t1.b),
      a,
      a+b*2+c*3+d*4
      FROM t1
      WHERE a>b;
  - name: t1

outputs:
