# Failed due to: https://github.com/superdb/super/issues/6549
script: |
  super -i parquet -f tsv -I q2795.sql | sort > q2795.out

inputs:
  - name: q2795.sql
    data: |
      SELECT a+b*2+c*3+d*4
      FROM t1
      WHERE e+d BETWEEN a+b-10 AND c+130
      AND EXISTS(SELECT 1 FROM t1 AS x WHERE x.b<t1.b)
      ORDER BY 1;
  - name: t1

outputs:
  - name: q2795.out
    data: |
      1272
