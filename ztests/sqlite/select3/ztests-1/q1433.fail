# Failed due to: https://github.com/superdb/super/issues/6549
script: |
  super -i parquet -f tsv -I q1433.sql | sort > q1433.out

inputs:
  - name: q1433.sql
    data: |
      SELECT c,
      a-b,
      b-c,
      (SELECT count(*) FROM t1 AS x WHERE x.c>t1.c AND x.d<t1.d)
      FROM t1
      WHERE c BETWEEN b-2 AND d+2
      AND (e>a AND e<b)
      AND d>e
      ORDER BY 4,2,3;
  - name: t1

outputs:
  - name: q1433.out
    data: |
      224	-3	-1	0
      247	-4	2	0
