# Failed due to: https://github.com/superdb/super/issues/6549
script: |
  super -i parquet -f tsv -I q2369.sql | sort > q2369.out

inputs:
  - name: q2369.sql
    data: |
      SELECT b-c,
      a+b*2,
      (a+b+c+d+e)/5,
      a
      FROM t1
      WHERE d NOT BETWEEN 110 AND 150
      AND a>b
      AND EXISTS(SELECT 1 FROM t1 AS x WHERE x.b<t1.b)
      ORDER BY 1,4,2;
  - name: t1

outputs:
  - name: q2369.out
    data: |
      -1	483	162	163
      -1	560	187	188
      -2	514	172	174
      -3	544	182	182
      -3	635	212	213
      1	698	232	234
      3	595	197	199
      3	685	227	229
      NULL	711	NULL	239
