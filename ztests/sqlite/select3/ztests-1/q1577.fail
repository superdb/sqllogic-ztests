# Failed due to: https://github.com/superdb/super/issues/6549
script: |
  super -i parquet -f tsv -I q1577.sql | sort > q1577.out

inputs:
  - name: q1577.sql
    data: |
      SELECT a+b*2+c*3+d*4+e*5,
      abs(a),
      a,
      b-c,
      (SELECT count(*) FROM t1 AS x WHERE x.b<t1.b),
      c-d
      FROM t1
      WHERE e+d BETWEEN a+b-10 AND c+130
      ORDER BY 6,1,4,3;
  - name: t1

outputs:
  - name: q1577.out
    data: |
      1612	107	107	-1	0	-2
      1902	127	127	4	3	-3
