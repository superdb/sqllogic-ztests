# Failed due to: https://github.com/superdb/super/issues/6549
script: |
  super -i parquet -f tsv -I q3060.sql | sort > q3060.out

inputs:
  - name: q3060.sql
    data: |
      SELECT b,
      a+b*2,
      a+b*2+c*3,
      e,
      a+b*2+c*3+d*4,
      (SELECT count(*) FROM t1 AS x WHERE x.c>t1.c AND x.d<t1.d)
      FROM t1
      WHERE c BETWEEN b-2 AND d+2
      AND d>e;
  - name: t1

outputs:
  - name: q3060.out
    data: |
      112	NULL	NULL	110	NULL	0
      130	391	793	132	1325	0
      139	416	827	135	1371	0
      160	483	966	162	1622	0
      181	544	1096	180	1828	0
      211	635	1277	210	2125	0
      223	666	1338	221	2226	0
      232	698	1391	230	2323	0
      249	743	1484	246	2476	0
