# Failed due to: https://github.com/superdb/super/issues/6549
script: |
  super -i parquet -f tsv -I q1940.sql | sort > q1940.out

inputs:
  - name: q1940.sql
    data: |
      SELECT d
      FROM t1
      WHERE d>e
      AND (e>c OR e<d)
      AND EXISTS(SELECT 1 FROM t1 AS x WHERE x.b<t1.b);
  - name: t1

outputs:
  - name: q1940.out
    data: |
      114
      128
      133
      136
      164
      183
      212
      222
      233
      238
      248
