# Failed due to: https://github.com/superdb/super/issues/6549
script: |
  super -i parquet -f tsv -I q339.sql | sort > q339.out

inputs:
  - name: q339.sql
    data: |
      SELECT CASE a+1 WHEN b THEN 111 WHEN c THEN 222
      WHEN d THEN 333  WHEN e THEN 444 ELSE 555 END,
      a+b*2+c*3,
      a+b*2+c*3+d*4,
      c-d
      FROM t1
      WHERE EXISTS(SELECT 1 FROM t1 AS x WHERE x.b<t1.b)
      AND (a>b-2 AND a<b+2)
      ORDER BY 1,2,4,3;
  - name: t1

outputs:
  - name: q339.out
    data: |
      111	827	1371	1
      111	851	1411	1
      333	1096	1828	1
      444	793	1325	1
      555	1000	NULL	NULL
      555	1180	1964	-1
      555	1360	2264	-1
      555	940	NULL	NULL
