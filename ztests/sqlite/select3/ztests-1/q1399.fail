# Failed due to: https://github.com/superdb/super/issues/6549
script: |
  super -i parquet -f tsv -I q1399.sql | sort > q1399.out

inputs:
  - name: q1399.sql
    data: |
      SELECT CASE a+1 WHEN b THEN 111 WHEN c THEN 222
      WHEN d THEN 333  WHEN e THEN 444 ELSE 555 END,
      c
      FROM t1
      WHERE (e>c OR e<d)
      AND b>c
      AND EXISTS(SELECT 1 FROM t1 AS x WHERE x.b<t1.b)
      ORDER BY 2,1;
  - name: t1

outputs:
  - name: q1399.out
    data: |
      111	137
      111	141
      333	125
      333	215
      444	247
      555	155
      555	195
      555	225
      555	231
