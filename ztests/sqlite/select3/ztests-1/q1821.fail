# Failed due to: https://github.com/superdb/super/issues/6549
script: |
  super -i parquet -f tsv -I q1821.sql | sort > q1821.out

inputs:
  - name: q1821.sql
    data: |
      SELECT b,
      a+b*2+c*3+d*4,
      (SELECT count(*) FROM t1 AS x WHERE x.c>t1.c AND x.d<t1.d),
      CASE WHEN a<b-3 THEN 111 WHEN a<=b THEN 222
      WHEN a<b+3 THEN 333 ELSE 444 END
      FROM t1
      WHERE a>b
      AND (e>c OR e<d)
      AND c BETWEEN b-2 AND d+2
      ORDER BY 2,1,3,4;
  - name: t1

outputs:
  - name: q1821.out
    data: |
      105	1067	0	333
      130	1325	0	333
      160	1622	0	444
      170	1714	0	444
      181	1828	0	333
      186	1861	0	333
      211	2125	0	333
      232	2323	0	333
