# Failed due to: https://github.com/superdb/super/issues/6549
script: |
  super -i parquet -f tsv -I q2464.sql | sort > q2464.out

inputs:
  - name: q2464.sql
    data: |
      SELECT CASE a+1 WHEN b THEN 111 WHEN c THEN 222
      WHEN d THEN 333  WHEN e THEN 444 ELSE 555 END,
      (SELECT count(*) FROM t1 AS x WHERE x.c>t1.c AND x.d<t1.d)
      FROM t1
      WHERE (e>c OR e<d)
      AND d>e
      AND (c<=d-2 OR c>=d+2);
  - name: t1

outputs:
  - name: q2464.out
    data: |
      222	0
      333	0
      333	0
      444	0
      555	0
