# Failed due to: https://github.com/superdb/super/issues/6549
script: |
  super -i parquet -f tsv -I q2845.sql | sort > q2845.out

inputs:
  - name: q2845.sql
    data: |
      SELECT (a+b+c+d+e)/5,
      CASE WHEN c>(SELECT avg(c) FROM t1) THEN a*2 ELSE b*10 END
      FROM t1
      WHERE d>e
      AND EXISTS(SELECT 1 FROM t1 AS x WHERE x.b<t1.b)
      AND b>c
      ORDER BY 2,1;
  - name: t1

outputs:
  - name: q2845.out
    data: |
      127	1290
      137	1390
      232	468
      247	490
