# Failed due to: https://github.com/superdb/super/issues/6549
script: |
  super -i parquet -f tsv -I q2717.sql | sort > q2717.out

inputs:
  - name: q2717.sql
    data: |
      SELECT CASE WHEN c>(SELECT avg(c) FROM t1) THEN a*2 ELSE b*10 END,
      (SELECT count(*) FROM t1 AS x WHERE x.b<t1.b)
      FROM t1
      WHERE e+d BETWEEN a+b-10 AND c+130
      ORDER BY 1,2;
  - name: t1

outputs:
  - name: q2717.out
    data: |
      1050	0
      1290	3
