# Failed due to: https://github.com/superdb/super/issues/6033
script: |
  super -i parquet -f tsv -I q496.sql | tr '\t' '\n' | sort > q496.out

inputs:
  - name: q496.sql
    data: |
      SELECT d3 FROM t3
      WHERE (376=b3)
      OR (c3=134 AND d3=541 AND b3=166 AND e3=145)
      OR d3 in (825,115,958,133,515,173,358,60,118,425,889,797,662,826)
      EXCEPT
      SELECT b5 FROM t5
      WHERE NOT (b5 in (771,569,292,897,661)
      OR b5 in (33,685,606,703,326,716))
      UNION
      SELECT c1 FROM t1
      WHERE c1 in (486,966,871)
      UNION
      SELECT e2 FROM t2
      WHERE (e2=125)
      OR a2 in (853,91,944,809,954,222,751,538,775)
      UNION ALL
      SELECT b6 FROM t6
      WHERE a6 in (255,182,696,238,452,718,692,829)
      UNION
      SELECT a9 FROM t9
      WHERE c9 in (662,419,253,257,711)
      OR (d9=161 AND c9=515 AND e9=368)
      OR a9 in (389,251,559,821,318)
      EXCEPT
      SELECT d4 FROM t4
      WHERE NOT ((637=a4 AND e4=377 AND 293=c4 AND 264=d4)
      OR (d4=950 OR 892=b4)
      OR (d4=929))
      UNION
      SELECT a7 FROM t7
      WHERE (341=d7)
      OR a7 in (921,325,85,879)
      OR b7 in (973,273,820,832,191,220,913);
  - name: t1
  - name: t2
  - name: t3
  - name: t4
  - name: t5
  - name: t6
  - name: t7
  - name: t8
  - name: t9

