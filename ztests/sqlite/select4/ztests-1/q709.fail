# Failed due to: https://github.com/superdb/super/issues/6033
script: |
  super -i parquet -f tsv -I q709.sql | tr '\t' '\n' | sort > q709.out

inputs:
  - name: q709.sql
    data: |
      SELECT c9 FROM t9
      WHERE (b9=595)
      OR (680=b9 OR 214=b9)
      OR (301=b9 AND e9=19 AND 104=d9 AND c9=936 AND a9=349)
      UNION
      SELECT e8 FROM t8
      WHERE (a8=386 OR c8=647 OR 446=d8)
      OR (503=b8)
      OR d8 in (849,391,781,880,738)
      EXCEPT
      SELECT d3 FROM t3
      WHERE NOT (e3 in (596,119,665,318,138,854,876,375,266,981,818,135,424,145))
      UNION ALL
      SELECT d1 FROM t1
      WHERE (574=d1 AND e1=313 AND a1=241 AND 168=c1 AND 729=b1)
      UNION ALL
      SELECT b7 FROM t7
      WHERE (166=b7 OR 979=e7)
      OR (360=b7 AND d7=801 AND 439=a7 AND e7=462)
      OR e7 in (979,900,782,841,499,844,462,827,976);
  - name: t1
  - name: t2
  - name: t3
  - name: t4
  - name: t5
  - name: t6
  - name: t7
  - name: t8
  - name: t9

outputs:
  - name: q709.out
    data: |
      101
      166
      250
      273
      306
