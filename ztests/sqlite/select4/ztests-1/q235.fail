# Failed due to: https://github.com/superdb/super/issues/6033
script: |
  super -i parquet -f tsv -I q235.sql | tr '\t' '\n' | sort > q235.out

inputs:
  - name: q235.sql
    data: |
      SELECT a2 FROM t2
      WHERE (853=a2 OR 544=a2)
      UNION ALL
      SELECT a5 FROM t5
      WHERE a5 in (721,319,132,917,341,536,878,270,696,342)
      OR c5 in (152,809,649,579,766,844,489,922,756,551,774,437,978)
      OR (104=e5 AND 391=b5 AND a5=602 AND 271=d5)
      UNION ALL
      SELECT d3 FROM t3
      WHERE e3 in (254,975,303,981,239,593)
      OR (184=a3)
      EXCEPT
      SELECT b8 FROM t8
      WHERE NOT ((d8=541 AND a8=628 AND 493=b8 AND 578=e8)
      OR c8 in (730,720,648,187))
      EXCEPT
      SELECT b7 FROM t7
      WHERE NOT (d7 in (500,492,891,684,114,666,325,902,395,549,296,28,939));
  - name: t1
  - name: t2
  - name: t3
  - name: t4
  - name: t5
  - name: t6
  - name: t7
  - name: t8
  - name: t9

outputs:
  - name: q235.out
    data: |
      109
      132
      170
      270
      311
      319
      330
      332
      341
      342
      357
      363
      445
      536
      544
      556
      597
      602
      637
