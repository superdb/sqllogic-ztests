# Failed due to: https://github.com/superdb/super/issues/6033
script: |
  super -i parquet -f tsv -I q870.sql | tr '\t' '\n' | sort > q870.out

inputs:
  - name: q870.sql
    data: |
      SELECT d9 FROM t9
      WHERE (a9=559 OR e9=868)
      INTERSECT
      SELECT b5 FROM t5
      WHERE NOT ((b5=205)
      OR (d5=537 AND b5=674 AND 975=e5)
      OR (373=a5 AND b5=231 AND e5=549));
  - name: t1
  - name: t2
  - name: t3
  - name: t4
  - name: t5
  - name: t6
  - name: t7
  - name: t8
  - name: t9

outputs:
  - name: q870.out
    data: |
