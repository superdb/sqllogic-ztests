# Failed due to: https://github.com/superdb/super/issues/6033
script: |
  super -i parquet -f tsv -I q947.sql | tr '\t' '\n' | sort > q947.out

inputs:
  - name: q947.sql
    data: |
      SELECT a7 FROM t7
      WHERE a7 in (706,134,180,995,945,62,884)
      OR (735=b7 OR 878=b7)
      OR e7 in (183,154,816)
      EXCEPT
      SELECT b1 FROM t1
      WHERE NOT (d1 in (172,828,17,748,504,232,519,691,130,96,972,799)
      OR (b1=894 AND 785=a1 AND 585=d1))
      EXCEPT
      SELECT c9 FROM t9
      WHERE NOT ((737=e9)
      OR (e9=788 AND 62=c9 AND 450=d9 AND b9=379 AND 413=a9))
      EXCEPT
      SELECT c5 FROM t5
      WHERE NOT ((579=c5))
      UNION
      SELECT e2 FROM t2
      WHERE (c2=148 AND 776=b2 AND e2=621)
      OR (988=c2 OR b2=276 OR a2=775)
      OR (b2=8 OR a2=268);
  - name: t1
  - name: t2
  - name: t3
  - name: t4
  - name: t5
  - name: t6
  - name: t7
  - name: t8
  - name: t9

outputs:
  - name: q947.out
    data: |
      134
      535
      62
      621
      622
      679
      706
      715
      753
      795
      820
      89
      899
      945
