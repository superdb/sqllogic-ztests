# Failed due to: https://github.com/superdb/super/issues/6033
script: |
  super -i parquet -f tsv -I q673.sql | tr '\t' '\n' | sort > q673.out

inputs:
  - name: q673.sql
    data: |
      SELECT c3 FROM t3
      WHERE e3 in (913,303,536,464,218,136,989,690,425,131,83,844,959,178)
      OR (e3=896 AND 827=b3 AND c3=455 AND 437=d3 AND 754=a3)
      UNION
      SELECT b8 FROM t8
      WHERE a8 in (341,994,894,472,417,250,289,563,591,838,312,127)
      OR (608=e8 AND d8=463 AND c8=790 AND 99=a8)
      OR b8 in (807,981,466,741,704,52)
      EXCEPT
      SELECT d4 FROM t4
      WHERE NOT ((b4=810)
      OR (465=e4 AND c4=712 AND d4=136)
      OR e4 in (805,206,273,790,350,619,390,38,958,352,71,212))
      EXCEPT
      SELECT d5 FROM t5
      WHERE NOT ((b5=623 OR b5=506 OR 56=b5)
      OR c5 in (579,222,384,3,927,599,721,924,443,12,598,809,729,31))
      UNION
      SELECT b6 FROM t6
      WHERE (851=a6 AND 416=c6)
      OR (c6=54 OR d6=2)
      OR (967=b6 AND 883=e6 AND a6=787 AND c6=216)
      UNION
      SELECT c2 FROM t2
      WHERE (e2=707 AND 900=c2 AND 784=b2)
      OR (d2=546 OR 837=c2)
      OR (706=b2);
  - name: t1
  - name: t2
  - name: t3
  - name: t4
  - name: t5
  - name: t6
  - name: t7
  - name: t8
  - name: t9

