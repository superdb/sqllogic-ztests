# Failed due to: https://github.com/superdb/super/issues/6033
script: |
  super -i parquet -f tsv -I q710.sql | tr '\t' '\n' | sort > q710.out

inputs:
  - name: q710.sql
    data: |
      SELECT d3 FROM t3
      WHERE (a3=353)
      OR (d3=164 OR b3=28)
      OR d3 in (642,403,826,336,726,743,841,958,913,434)
      INTERSECT
      SELECT d9 FROM t9
      WHERE NOT (b9 in (804,864,746,12,855,210,5,289,74,524,19,227)
      OR (e9=195)
      OR (b9=746 OR a9=879))
      INTERSECT
      SELECT b4 FROM t4
      WHERE NOT ((82=a4 AND 417=c4 AND 617=d4)
      OR a4 in (92,439,505,473,596,423)
      OR (d4=376 OR 667=c4 OR 996=c4));
  - name: t1
  - name: t2
  - name: t3
  - name: t4
  - name: t5
  - name: t6
  - name: t7
  - name: t8
  - name: t9

outputs:
  - name: q710.out
    data: |
