# Failed due to: https://github.com/superdb/super/issues/6033
script: |
  super -i parquet -f tsv -I q852.sql | tr '\t' '\n' | sort > q852.out

inputs:
  - name: q852.sql
    data: |
      SELECT d3 FROM t3
      WHERE (490=c3)
      UNION ALL
      SELECT c2 FROM t2
      WHERE (923=e2)
      OR (c2=725 OR 819=b2 OR e2=37)
      OR (723=d2)
      EXCEPT
      SELECT b5 FROM t5
      WHERE NOT (c5 in (351,86,185,941,602,941,140,668,196)
      OR (587=b5))
      UNION ALL
      SELECT d6 FROM t6
      WHERE (243=b6 OR c6=807 OR e6=95)
      UNION ALL
      SELECT d7 FROM t7
      WHERE c7 in (80,103,180,589,691,944,553,705,488,661,302,441,482,92)
      OR d7 in (226,391,328,787,549,724,886,148,436,603,709,341,212,817)
      EXCEPT
      SELECT e8 FROM t8
      WHERE NOT (c8 in (168,935,692,965,160,111,100,821,354,284,233,789)
      OR (a8=672 AND d8=580 AND e8=736 AND 211=b8 AND c8=789))
      EXCEPT
      SELECT a1 FROM t1
      WHERE NOT ((254=d1)
      OR (a1=231 AND e1=795 AND b1=468)
      OR c1 in (498,172,482,177,97,915,62,617,252));
  - name: t1
  - name: t2
  - name: t3
  - name: t4
  - name: t5
  - name: t6
  - name: t7
  - name: t8
  - name: t9

