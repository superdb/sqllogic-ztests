# Failed due to: https://github.com/superdb/super/issues/6033
script: |
  super -i parquet -f tsv -I q312.sql | tr '\t' '\n' | sort > q312.out

inputs:
  - name: q312.sql
    data: |
      SELECT d9 FROM t9
      WHERE (854=e9 AND 305=d9)
      OR a9 in (104,959,177,685,468,41,553)
      OR b9 in (251,751,103,19,301,289,848,74,122)
      EXCEPT
      SELECT e3 FROM t3
      WHERE NOT ((c3=792 AND d3=38 AND 383=a3 AND 972=e3))
      EXCEPT
      SELECT a2 FROM t2
      WHERE NOT ((386=e2)
      OR e2 in (366,114,512,554,483,899,808)
      OR d2 in (669,198,663))
      UNION
      SELECT a5 FROM t5
      WHERE d5 in (977,412,940,649,443)
      EXCEPT
      SELECT d8 FROM t8
      WHERE NOT (b8 in (975,540,806,98,770,673))
      UNION
      SELECT b4 FROM t4
      WHERE b4 in (331,408,964,23,94,137,892)
      UNION
      SELECT d1 FROM t1
      WHERE (12=e1 AND c1=617 AND a1=544)
      EXCEPT
      SELECT d6 FROM t6
      WHERE NOT (c6 in (292,749,938,500,609,328,135,45,506,452)
      OR (729=d6 OR d6=790 OR 954=b6))
      EXCEPT
      SELECT e7 FROM t7
      WHERE NOT ((689=e7)
      OR a7 in (466,876,114,995,982,832)
      OR (912=a7 AND 234=b7 AND 215=e7 AND 682=c7 AND 79=d7));
  - name: t1
  - name: t2
  - name: t3
  - name: t4
  - name: t5
  - name: t6
  - name: t7
  - name: t8
  - name: t9

