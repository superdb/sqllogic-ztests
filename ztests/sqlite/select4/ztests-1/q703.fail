# Failed due to: https://github.com/superdb/super/issues/6033
script: |
  super -i parquet -f tsv -I q703.sql | tr '\t' '\n' | sort > q703.out

inputs:
  - name: q703.sql
    data: |
      SELECT b7 FROM t7
      WHERE (998=a7 AND d7=722 AND c7=441)
      OR d7 in (485,549,785,777,457)
      EXCEPT
      SELECT c5 FROM t5
      WHERE NOT (d5 in (171,858,792,480,520,344,667,132,565,437,856,835,542,919))
      UNION
      SELECT a6 FROM t6
      WHERE (b6=158)
      OR (c6=187)
      EXCEPT
      SELECT a9 FROM t9
      WHERE NOT ((965=e9)
      OR (e9=278 AND a9=318 AND c9=288)
      OR (d9=737))
      UNION ALL
      SELECT b3 FROM t3
      WHERE e3 in (665,192,318,837,731,728,651,449,550,975,774)
      UNION ALL
      SELECT d2 FROM t2
      WHERE (d2=404 AND 511=c2 AND 279=b2);
  - name: t1
  - name: t2
  - name: t3
  - name: t4
  - name: t5
  - name: t6
  - name: t7
  - name: t8
  - name: t9

outputs:
  - name: q703.out
    data: |
      113
      152
      191
      202
      317
      376
      381
      404
      407
      454
      457
      551
      592
      665
      677
      720
      878
      921
      973
