# Failed due to: https://github.com/superdb/super/issues/6033
script: |
  super -i parquet -f tsv -I q142.sql | tr '\t' '\n' | sort > q142.out

inputs:
  - name: q142.sql
    data: |
      SELECT a8 FROM t8
      WHERE b8 in (609,52,244,656,351,773,325,870,105,365)
      OR (a8=900)
      OR c8 in (419,154,461,297,188,961,74,79,730,799)
      EXCEPT
      SELECT e4 FROM t4
      WHERE NOT ((e4=885 AND 220=b4)
      OR a4 in (981,793,139,422,625,107,450,580)
      OR e4 in (977,552,38,324,476,311,858,223,767,554,151,592,252))
      EXCEPT
      SELECT a7 FROM t7
      WHERE NOT (c7 in (397,98,341,966,478,557,341,606,887,744,260,238,142)
      OR (280=b7))
      UNION ALL
      SELECT a1 FROM t1
      WHERE b1 in (828,645,42,570,247,738,346,894,462,226,435,43,593);
  - name: t1
  - name: t2
  - name: t3
  - name: t4
  - name: t5
  - name: t6
  - name: t7
  - name: t8
  - name: t9

