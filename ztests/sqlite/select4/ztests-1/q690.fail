# Failed due to: https://github.com/superdb/super/issues/6033
script: |
  super -i parquet -f tsv -I q690.sql | tr '\t' '\n' | sort > q690.out

inputs:
  - name: q690.sql
    data: |
      SELECT d4 FROM t4
      WHERE a4 in (74,952,919,474,185,948,82,16,580,160,847,451,922)
      OR (778=e4 AND 728=c4 AND 849=b4)
      OR (713=d4 OR 919=b4)
      EXCEPT
      SELECT d1 FROM t1
      WHERE NOT ((14=e1 OR a1=754 OR 776=a1)
      OR (683=e1 AND 433=a1 AND 230=c1 AND 803=d1 AND b1=807))
      UNION ALL
      SELECT e5 FROM t5
      WHERE (697=c5 AND 196=a5)
      EXCEPT
      SELECT b8 FROM t8
      WHERE NOT ((e8=956 OR 242=a8)
      OR b8 in (145,673,964,862,665,352,770,773,253,469,677,891,259,324))
      EXCEPT
      SELECT b3 FROM t3
      WHERE NOT ((d3=423 AND c3=133))
      UNION ALL
      SELECT b7 FROM t7
      WHERE (c7=606)
      OR a7 in (699,233,896,876)
      OR (e7=979)
      EXCEPT
      SELECT c9 FROM t9
      WHERE NOT ((326=a9));
  - name: t1
  - name: t2
  - name: t3
  - name: t4
  - name: t5
  - name: t6
  - name: t7
  - name: t8
  - name: t9

outputs:
  - name: q690.out
    data: |
      229
      328
      441
      524
      59
      628
      655
      726
      728
      813
      868
      968
      989
      996
