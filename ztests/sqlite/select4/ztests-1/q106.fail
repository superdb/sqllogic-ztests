# Failed due to: https://github.com/superdb/super/issues/6033
script: |
  super -i parquet -f tsv -I q106.sql | tr '\t' '\n' | sort > q106.out

inputs:
  - name: q106.sql
    data: |
      SELECT e3 FROM t3
      WHERE (737=d3 AND 454=b3 AND e3=837 AND 836=a3 AND 339=c3)
      OR (516=c3 AND d3=641 AND 551=a3)
      EXCEPT
      SELECT c9 FROM t9
      WHERE NOT (d9 in (960,264,597,763,383,602,347,389,606,679,628,274)
      OR (312=b9 OR 218=a9 OR a9=215)
      OR (a9=567 OR 171=b9 OR b9=447))
      UNION
      SELECT e1 FROM t1
      WHERE (283=b1 OR b1=211)
      OR a1 in (179,231,406,785,988,732,637,607,868,498,538,283,853)
      OR (c1=870 OR 872=e1)
      EXCEPT
      SELECT b7 FROM t7
      WHERE NOT (c7 in (435,344,780,389,564,931,589)
      OR (d7=805 AND c7=243 AND 422=b7))
      UNION
      SELECT d5 FROM t5
      WHERE b5 in (230,84,784,782,731,789,205,530,665,774,736,897)
      OR (731=b5)
      OR d5 in (667,514,413,960,33,738,937,856)
      EXCEPT
      SELECT c4 FROM t4
      WHERE NOT ((661=d4))
      UNION ALL
      SELECT e6 FROM t6
      WHERE (647=d6 AND c6=452 AND a6=355 AND 997=b6 AND e6=754)
      OR (511=b6)
      OR d6 in (192,269,72,790)
      EXCEPT
      SELECT d2 FROM t2
      WHERE NOT ((d2=833)
      OR (282=c2)
      OR (733=a2))
      UNION
      SELECT d8 FROM t8
      WHERE (578=a8 AND e8=41 AND c8=521)
      OR a8 in (894,153,952,961,171,359,210,359,127,259,591,502)
      OR (244=b8 AND 564=a8);
  - name: t1
  - name: t2
  - name: t3
  - name: t4
  - name: t5
  - name: t6
  - name: t7
  - name: t8
  - name: t9

