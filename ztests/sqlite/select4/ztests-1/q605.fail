# Failed due to: https://github.com/superdb/super/issues/6033
script: |
  super -i parquet -f tsv -I q605.sql | tr '\t' '\n' | sort > q605.out

inputs:
  - name: q605.sql
    data: |
      SELECT c5 FROM t5
      WHERE (d5=309 OR c5=824 OR 819=c5)
      UNION
      SELECT c1 FROM t1
      WHERE e1 in (181,12,956,795,685,313,558,731,779,146,815,228)
      EXCEPT
      SELECT c3 FROM t3
      WHERE NOT ((c3=692 AND d3=102 AND 197=a3)
      OR c3 in (806,697,809,73,455,395,961,826,800,656)
      OR c3 in (492,885,733,86,961,777,127,476,516))
      UNION
      SELECT a9 FROM t9
      WHERE b9 in (688,19,426,848,269)
      OR e9 in (704,239,307)
      UNION ALL
      SELECT a7 FROM t7
      WHERE d7 in (782,687,988,325,524,485,418,457,91,575,709)
      EXCEPT
      SELECT b6 FROM t6
      WHERE NOT ((d6=767 OR 116=a6))
      EXCEPT
      SELECT d4 FROM t4
      WHERE NOT ((e4=600)
      OR (d4=509 AND c4=162)
      OR c4 in (521,119,201,297,208,366,832,854,584,0))
      EXCEPT
      SELECT e2 FROM t2
      WHERE NOT (a2 in (733,637,709,374,382,691,1,93,253,76,495,944,522));
  - name: t1
  - name: t2
  - name: t3
  - name: t4
  - name: t5
  - name: t6
  - name: t7
  - name: t8
  - name: t9

