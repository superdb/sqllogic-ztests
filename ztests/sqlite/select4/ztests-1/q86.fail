# Failed due to: https://github.com/superdb/super/issues/6033
script: |
  super -i parquet -f tsv -I q86.sql | tr '\t' '\n' | sort > q86.out

inputs:
  - name: q86.sql
    data: |
      SELECT d7 FROM t7
      WHERE (323=b7 AND c7=589)
      OR e7 in (462,6,79,887,89,201,816,439)
      UNION
      SELECT c4 FROM t4
      WHERE (749=c4 AND 608=b4 AND d4=706 AND 540=a4 AND 349=e4)
      UNION ALL
      SELECT a2 FROM t2
      WHERE (c2=283 OR a2=297)
      OR b2 in (864,857,519,73,812,113)
      EXCEPT
      SELECT e6 FROM t6
      WHERE NOT ((811=a6 AND 295=c6 AND 595=e6 AND b6=963 AND 60=d6))
      UNION
      SELECT d3 FROM t3
      WHERE (a3=380 AND 890=c3)
      OR (122=b3)
      UNION ALL
      SELECT e9 FROM t9
      WHERE e9 in (383,117,426,82,368,445)
      OR (943=e9 AND 269=b9 AND d9=274 AND c9=923)
      OR e9 in (383,788,149,542,567,61);
  - name: t1
  - name: t2
  - name: t3
  - name: t4
  - name: t5
  - name: t6
  - name: t7
  - name: t8
  - name: t9

outputs:
  - name: q86.out
    data: |
      117
