# Failed due to: https://github.com/superdb/super/issues/6033
script: |
  super -i parquet -f tsv -I q796.sql | tr '\t' '\n' | sort > q796.out

inputs:
  - name: q796.sql
    data: |
      SELECT d8 FROM t8
      WHERE (b8=364)
      UNION ALL
      SELECT e3 FROM t3
      WHERE c3 in (516,146,372,898,375,961,542,73,467)
      OR a3 in (995,429,5,105,836,34,337,699,784,234,184,947,611,952)
      EXCEPT
      SELECT a5 FROM t5
      WHERE NOT (b5 in (230,412,703,499,771,84,320,33)
      OR (787=d5 AND 729=c5 AND e5=558 AND b5=433)
      OR (c5=222 AND b5=897))
      EXCEPT
      SELECT e9 FROM t9
      WHERE NOT (a9 in (683,251,5,102,148,149,335,72,821,389,611))
      UNION
      SELECT d7 FROM t7
      WHERE b7 in (892,178,129,798,636,804,921,881,396,519,655,120,488,660)
      OR a7 in (416,386,925,958,180,89,439,500)
      OR (c7=548 AND 680=d7)
      UNION
      SELECT e2 FROM t2
      WHERE (d2=263)
      OR (c2=107 AND 681=b2 AND 225=d2 AND 455=a2 AND e2=556)
      OR (223=a2)
      EXCEPT
      SELECT d4 FROM t4
      WHERE NOT (e4 in (511,71,760,512,63,491)
      OR a4 in (261,378,16)
      OR c4 in (82,783,752,238,660,513,799,996,271,508,749))
      UNION
      SELECT d6 FROM t6
      WHERE c6 in (265,216,295,25,749,328,424,975,452,146,446,928)
      OR (a6=751)
      OR c6 in (490,377,729,66,752,270)
      UNION
      SELECT c1 FROM t1
      WHERE (639=c1 AND 20=a1)
      OR (d1=323 OR b1=788)
      OR (767=a1 OR c1=152 OR a1=607);
  - name: t1
  - name: t2
  - name: t3
  - name: t4
  - name: t5
  - name: t6
  - name: t7
  - name: t8
  - name: t9

