# Failed due to: https://github.com/superdb/super/issues/6033
script: |
  super -i parquet -f tsv -I q715.sql | tr '\t' '\n' | sort > q715.out

inputs:
  - name: q715.sql
    data: |
      SELECT a1 FROM t1
      WHERE d1 in (922,602,223,571,942,691)
      OR (717=e1)
      OR (e1=117 AND b1=696 AND a1=20)
      UNION
      SELECT a5 FROM t5
      WHERE b5 in (897,531,143,91)
      OR (b5=260 OR c5=351)
      EXCEPT
      SELECT a2 FROM t2
      WHERE NOT (e2 in (923,688,564,37,381,131,955,427,205,433)
      OR d2 in (8,317,328,46,498))
      UNION
      SELECT b3 FROM t3
      WHERE (c3=607 AND e3=424 AND 245=a3 AND 816=b3);
  - name: t1
  - name: t2
  - name: t3
  - name: t4
  - name: t5
  - name: t6
  - name: t7
  - name: t8
  - name: t9

outputs:
  - name: q715.out
    data: |
      114
      195
      196
      20
      299
      335
      476
      607
      730
      816
      866
