# Failed due to: https://github.com/superdb/super/issues/6033
script: |
  super -i parquet -f tsv -I q232.sql | tr '\t' '\n' | sort > q232.out

inputs:
  - name: q232.sql
    data: |
      SELECT b6 FROM t6
      WHERE a6 in (604,255,692,696,452,801)
      OR (6=b6 AND 942=d6 AND 725=a6 AND 439=e6)
      UNION ALL
      SELECT a5 FROM t5
      WHERE (132=a5)
      OR d5 in (344,787,4,419,462,42,309,33,855,413,910)
      OR (a5=917 OR 858=d5 OR e5=708)
      UNION ALL
      SELECT c4 FROM t4
      WHERE (e4=132 OR c4=88)
      OR (c4=971 AND e4=48 AND 480=b4 AND 29=a4 AND d4=366)
      OR (331=b4)
      EXCEPT
      SELECT a8 FROM t8
      WHERE NOT (e8 in (46,203,736,149,392,729,384,186,497,678,41,592,561)
      OR e8 in (561,761,487,44,422,180,495,579,223,476,600,792,635,811)
      OR (161=d8 OR a8=472 OR 792=e8))
      EXCEPT
      SELECT a2 FROM t2
      WHERE NOT ((83=c2 OR c2=202 OR e2=673))
      UNION ALL
      SELECT b9 FROM t9
      WHERE (912=d9);
  - name: t1
  - name: t2
  - name: t3
  - name: t4
  - name: t5
  - name: t6
  - name: t7
  - name: t8
  - name: t9

outputs:
  - name: q232.out
    data: |
      119
      132
      144
      180
      190
      226
      267
      300
      34
      541
      599
      6
      685
      749
      782
      800
