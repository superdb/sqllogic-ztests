# Failed due to: https://github.com/superdb/super/issues/6033
script: |
  super -i parquet -f tsv -I q708.sql | tr '\t' '\n' | sort > q708.out

inputs:
  - name: q708.sql
    data: |
      SELECT c1 FROM t1
      WHERE a1 in (194,607,23,538,517,189,330,825,479,52,231)
      OR (e1=14 OR 213=b1)
      UNION
      SELECT c7 FROM t7
      WHERE (360=b7 AND 948=c7 AND d7=801)
      EXCEPT
      SELECT b2 FROM t2
      WHERE NOT (d2 in (651,377,546,86,454,682,643,598,158,931,723));
  - name: t1
  - name: t2
  - name: t3
  - name: t4
  - name: t5
  - name: t6
  - name: t7
  - name: t8
  - name: t9

outputs:
  - name: q708.out
    data: |
      200
      204
      289
      315
      39
      402
      441
      486
      623
      683
      870
      902
      948
      97
