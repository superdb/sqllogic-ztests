# Failed due to: https://github.com/superdb/super/issues/6033
script: |
  super -i parquet -f tsv -I q451.sql | tr '\t' '\n' | sort > q451.out

inputs:
  - name: q451.sql
    data: |
      SELECT d1 FROM t1
      WHERE b1 in (556,788,523,993,584,944,446,432,556,525,807)
      OR (32=b1)
      OR (88=c1)
      UNION
      SELECT b6 FROM t6
      WHERE (d6=60)
      OR (e6=847 OR 415=c6)
      EXCEPT
      SELECT e5 FROM t5
      WHERE NOT ((a5=89)
      OR (429=a5))
      UNION ALL
      SELECT c3 FROM t3
      WHERE d3 in (482,615,503)
      EXCEPT
      SELECT b8 FROM t8
      WHERE NOT (d8 in (767,494,761)
      OR (272=e8 AND 269=b8 AND d8=14 AND 952=a8)
      OR (a8=113 AND 394=b8 AND d8=223 AND e8=729))
      EXCEPT
      SELECT b2 FROM t2
      WHERE NOT ((e2=721 AND a2=445 AND c2=511)
      OR (318=c2 OR c2=65 OR e2=671))
      UNION ALL
      SELECT b4 FROM t4
      WHERE b4 in (535,882,577,847,678,748,941,907,498,888,603);
  - name: t1
  - name: t2
  - name: t3
  - name: t4
  - name: t5
  - name: t6
  - name: t7
  - name: t8
  - name: t9

outputs:
  - name: q451.out
    data: |
      121
      17
      213
      298
      319
      323
      346
      395
      498
      535
      577
      603
      678
      748
      793
      828
      83
      847
      86
      87
      882
