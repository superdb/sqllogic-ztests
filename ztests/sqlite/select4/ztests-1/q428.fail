# Failed due to: https://github.com/superdb/super/issues/6033
script: |
  super -i parquet -f tsv -I q428.sql | tr '\t' '\n' | sort > q428.out

inputs:
  - name: q428.sql
    data: |
      SELECT d2 FROM t2
      WHERE b2 in (509,799,527,643,632,674,811,297,353,592,765,148,585,161)
      OR a2 in (718,131,186,189)
      EXCEPT
      SELECT d9 FROM t9
      WHERE NOT (b9 in (912,239,746,63,549,122,66)
      OR b9 in (680,549,746,50,301,342,125,170,122,128,26,578)
      OR b9 in (66,832,2,868,239,447,142,496,12,926,77,50,759,136));
  - name: t1
  - name: t2
  - name: t3
  - name: t4
  - name: t5
  - name: t6
  - name: t7
  - name: t8
  - name: t9

outputs:
  - name: q428.out
    data: |
      137
      215
      241
      249
      260
      263
      284
      345
      351
      476
      537
      598
      651
      813
      833
      847
      873
      914
      953
