# Failed due to: https://github.com/superdb/super/issues/6549
script: |
  super -i parquet -f tsv -I q809.sql > q809.out

inputs:
  - name: q809.sql
    data: |
      SELECT CASE a+1 WHEN b THEN 111 WHEN c THEN 222
      WHEN d THEN 333  WHEN e THEN 444 ELSE 555 END,
      b-c,
      (SELECT count(*) FROM t1 AS x WHERE x.b<t1.b),
      d-e
      FROM t1
      ORDER BY 3,1,4,2;
  - name: t1

outputs:
  - name: q809.out
    data: |
      555	-2	0	-2
      333	-1	1	-1
      111	-1	2	4
      333	-1	3	-1
      333	1	4	2
      333	4	5	2
      444	-4	6	1
      111	2	7	1
      111	2	8	-4
      555	-2	9	2
      333	1	10	2
      555	3	11	-1
      333	-1	12	2
      333	1	13	4
      555	-2	14	-2
      555	-1	15	1
      333	-3	16	3
      444	-1	17	-4
      444	1	18	-2
      555	3	19	-1
      222	-2	20	-1
      111	-2	21	-2
      222	-3	22	2
      333	3	23	-2
      444	-1	24	1
      555	3	25	-1
      555	1	26	3
      555	1	27	1
      222	-4	28	-1
      444	2	29	2
