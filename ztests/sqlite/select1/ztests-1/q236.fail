# Failed due to: https://github.com/superdb/super/issues/6549
script: |
  super -i parquet -f tsv -I q236.sql > q236.out

inputs:
  - name: q236.sql
    data: |
      SELECT a,
      abs(a),
      (a+b+c+d+e)/5,
      (SELECT count(*) FROM t1 AS x WHERE x.c>t1.c AND x.d<t1.d)
      FROM t1
      ORDER BY 3,1,2,4;
  - name: t1

