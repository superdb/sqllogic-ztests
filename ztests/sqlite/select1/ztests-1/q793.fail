# Failed due to: https://github.com/superdb/super/issues/6549
script: |
  super -i parquet -f tsv -I q793.sql > q793.out

inputs:
  - name: q793.sql
    data: |
      SELECT c,
      (SELECT count(*) FROM t1 AS x WHERE x.b<t1.b),
      (a+b+c+d+e)/5,
      a+b*2+c*3+d*4,
      abs(b-c),
      a+b*2,
      d-e
      FROM t1
      ORDER BY 4,3,1,7,2,5,6;
  - name: t1

