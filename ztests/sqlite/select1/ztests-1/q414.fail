# Failed due to: https://github.com/superdb/super/issues/6549
script: |
  super -i parquet -f tsv -I q414.sql > q414.out

inputs:
  - name: q414.sql
    data: |
      SELECT (a+b+c+d+e)/5,
      d,
      CASE WHEN c>(SELECT avg(c) FROM t1) THEN a*2 ELSE b*10 END,
      a+b*2+c*3+d*4,
      a,
      abs(a),
      a-b
      FROM t1
      WHERE (a>b-2 AND a<b+2)
      AND EXISTS(SELECT 1 FROM t1 AS x WHERE x.b<t1.b)
      AND e+d BETWEEN a+b-10 AND c+130
      ORDER BY 5,4,1,2,7,6,3;
  - name: t1

outputs:
  - name: q414.out
    data: |
      112	114	1120	1130	111	111	-1
