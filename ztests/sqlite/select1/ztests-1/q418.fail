# Failed due to: https://github.com/superdb/super/issues/6549
script: |
  super -i parquet -f tsv -I q418.sql > q418.out

inputs:
  - name: q418.sql
    data: |
      SELECT (SELECT count(*) FROM t1 AS x WHERE x.c>t1.c AND x.d<t1.d),
      d-e,
      CASE WHEN c>(SELECT avg(c) FROM t1) THEN a*2 ELSE b*10 END,
      (SELECT count(*) FROM t1 AS x WHERE x.b<t1.b),
      c
      FROM t1
      WHERE d>e
      OR a>b
      ORDER BY 4,3,2,1,5;
  - name: t1

outputs:
  - name: q418.out
    data: |
      0	-2	1000	0	102
