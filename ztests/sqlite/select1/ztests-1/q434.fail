# Failed due to: https://github.com/superdb/super/issues/6549
script: |
  super -i parquet -f tsv -I q434.sql > q434.out

inputs:
  - name: q434.sql
    data: |
      SELECT a+b*2+c*3+d*4+e*5,
      d-e,
      (SELECT count(*) FROM t1 AS x WHERE x.c>t1.c AND x.d<t1.d),
      abs(b-c),
      c-d
      FROM t1
      ORDER BY 2,1,3,4,5;
  - name: t1

outputs:
  - name: q434.out
    data: |
      2131	-4	0	2	1
      2806	-4	0	1	2
      1529	-2	0	2	1
