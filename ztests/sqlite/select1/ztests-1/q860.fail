# Failed due to: https://github.com/superdb/super/issues/6549
script: |
  super -i parquet -f tsv -I q860.sql > q860.out

inputs:
  - name: q860.sql
    data: |
      SELECT CASE WHEN a<b-3 THEN 111 WHEN a<=b THEN 222
      WHEN a<b+3 THEN 333 ELSE 444 END,
      (SELECT count(*) FROM t1 AS x WHERE x.b<t1.b),
      d,
      a-b,
      abs(b-c)
      FROM t1
      WHERE e+d BETWEEN a+b-10 AND c+130
      OR EXISTS(SELECT 1 FROM t1 AS x WHERE x.b<t1.b)
      ORDER BY 1,5,3,2,4;
  - name: t1

outputs:
  - name: q860.out
    data: |
      111	29	248	-4	2
