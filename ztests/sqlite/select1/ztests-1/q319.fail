# Failed due to: https://github.com/superdb/super/issues/6549
script: |
  super -i parquet -f tsv -I q319.sql > q319.out

inputs:
  - name: q319.sql
    data: |
      SELECT (SELECT count(*) FROM t1 AS x WHERE x.c>t1.c AND x.d<t1.d),
      c,
      a,
      (a+b+c+d+e)/5
      FROM t1
      ORDER BY 2,3,1,4;
  - name: t1

outputs:
