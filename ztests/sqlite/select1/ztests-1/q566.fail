# Failed due to: https://github.com/superdb/super/issues/6549
script: |
  super -i parquet -f tsv -I q566.sql > q566.out

inputs:
  - name: q566.sql
    data: |
      SELECT b,
      (SELECT count(*) FROM t1 AS x WHERE x.b<t1.b),
      (a+b+c+d+e)/5
      FROM t1
      WHERE d>e
      OR (a>b-2 AND a<b+2)
      OR EXISTS(SELECT 1 FROM t1 AS x WHERE x.b<t1.b)
      ORDER BY 2,1,3;
  - name: t1

outputs:
  - name: q566.out
    data: |
      105	1	107
      112	2	112
      118	3	117
      124	4	122
      129	5	127
      130	6	132
      139	7	137
