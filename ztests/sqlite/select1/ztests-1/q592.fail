# Failed due to: https://github.com/superdb/super/issues/6549
script: |
  super -i parquet -f tsv -I q592.sql > q592.out

inputs:
  - name: q592.sql
    data: |
      SELECT abs(b-c),
      (a+b+c+d+e)/5,
      (SELECT count(*) FROM t1 AS x WHERE x.b<t1.b),
      abs(a),
      c,
      a+b*2+c*3
      FROM t1
      WHERE a>b
      ORDER BY 3,4,6,1,2,5;
  - name: t1

