# Failed due to: https://github.com/superdb/super/issues/6549
script: |
  super -i parquet -f tsv -I q377.sql > q377.out

inputs:
  - name: q377.sql
    data: |
      SELECT a+b*2,
      a+b*2+c*3,
      a-b,
      (SELECT count(*) FROM t1 AS x WHERE x.b<t1.b)
      FROM t1
      ORDER BY 4,1,2,3;
  - name: t1

