# Failed due to: https://github.com/superdb/super/issues/6549
script: |
  super -i parquet -f tsv -I q801.sql > q801.out

inputs:
  - name: q801.sql
    data: |
      SELECT (SELECT count(*) FROM t1 AS x WHERE x.c>t1.c AND x.d<t1.d),
      (a+b+c+d+e)/5,
      c-d,
      CASE WHEN c>(SELECT avg(c) FROM t1) THEN a*2 ELSE b*10 END,
      d,
      a+b*2+c*3+d*4,
      abs(a)
      FROM t1
      WHERE (c<=d-2 OR c>=d+2)
      ORDER BY 2,5,1,3,7,6,4;
  - name: t1

outputs:
  - name: q801.out
    data: |
      0	107	-2	1050	108	1067	107
      0	117	3	1180	116	1172	115
      0	127	-3	1290	128	1272	127
      0	152	-4	1510	154	1521	153
      0	162	-3	1600	164	1622	163
      0	167	-3	1670	169	1676	168
      0	177	-2	358	178	1769	179
      0	187	2	376	185	1861	188
      0	192	3	382	190	1918	191
      0	212	2	426	212	2125	213
      0	217	-2	432	217	2165	216
      0	222	2	440	222	2226	220
      0	232	-2	468	233	2323	234
      0	237	-3	478	238	2368	239
      0	242	3	486	241	2419	243
