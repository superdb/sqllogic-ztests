# Failed due to: https://github.com/superdb/super/issues/6549
script: |
  super -i parquet -f tsv -I q398.sql > q398.out

inputs:
  - name: q398.sql
    data: |
      SELECT abs(b-c),
      c,
      b,
      (a+b+c+d+e)/5,
      (SELECT count(*) FROM t1 AS x WHERE x.c>t1.c AND x.d<t1.d),
      d
      FROM t1
      WHERE d>e
      ORDER BY 6,5,3,1,2,4;
  - name: t1

outputs:
  - name: q398.out
    data: |
      1	113	112	112	0	114
      1	123	124	122	0	122
      4	125	129	127	0	128
      4	134	130	132	0	133
      2	137	139	137	0	136
      2	147	145	147	0	148
      1	150	151	152	0	154
      1	161	160	162	0	164
      1	166	167	167	0	169
      1	176	175	177	0	178
      3	184	181	182	0	183
      3	214	211	212	0	212
      1	224	223	222	0	222
      1	231	232	232	0	233
      1	235	236	237	0	238
