# Failed due to: https://github.com/superdb/super/issues/6549
script: |
  super -i parquet -f tsv -I q443.sql > q443.out

inputs:
  - name: q443.sql
    data: |
      SELECT b,
      c,
      abs(a),
      (SELECT count(*) FROM t1 AS x WHERE x.c>t1.c AND x.d<t1.d),
      b-c,
      e
      FROM t1
      ORDER BY 4,5,1,6,2,3;
  - name: t1

