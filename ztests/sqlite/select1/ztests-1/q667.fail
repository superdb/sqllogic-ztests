# Failed due to: https://github.com/superdb/super/issues/6549
script: |
  super -i parquet -f tsv -I q667.sql > q667.out

inputs:
  - name: q667.sql
    data: |
      SELECT a+b*2,
      abs(b-c),
      a+b*2+c*3,
      c,
      e,
      d
      FROM t1
      WHERE EXISTS(SELECT 1 FROM t1 AS x WHERE x.b<t1.b)
      OR b>c
      ORDER BY 6,3,5,2,1,4;
  - name: t1

