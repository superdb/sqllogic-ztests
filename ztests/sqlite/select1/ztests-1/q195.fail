# Failed due to: https://github.com/superdb/super/issues/6549
script: |
  super -i parquet -f tsv -I q195.sql > q195.out

inputs:
  - name: q195.sql
    data: |
      SELECT (SELECT count(*) FROM t1 AS x WHERE x.c>t1.c AND x.d<t1.d),
      e,
      a+b*2+c*3+d*4,
      CASE WHEN a<b-3 THEN 111 WHEN a<=b THEN 222
      WHEN a<b+3 THEN 333 ELSE 444 END,
      a+b*2+c*3,
      abs(a),
      c-d
      FROM t1
      WHERE c BETWEEN b-2 AND d+2
      OR (e>c OR e<d)
      ORDER BY 1,4,2,5,7,3,6;
  - name: t1

