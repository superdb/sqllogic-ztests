      192	0	222
      197	0	333
      212	0	333
      217	0	222
      222	0	222
      227	0	333
      232	0	333
      247	0	111
      NULL	0	222
      NULL	0	333
      NULL	0	333
      NULL	0	333
      NULL	0	444
      NULL	0	444
      NULL	0	444
