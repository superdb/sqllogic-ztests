# Failed due to: https://github.com/superdb/super/issues/6549
script: |
  super -i parquet -f tsv -I q557.sql | sort > q557.out

inputs:
  - name: q557.sql
    data: |
      SELECT (a+b+c+d+e)/5,
      (SELECT count(*) FROM t1 AS x WHERE x.c>t1.c AND x.d<t1.d),
      CASE WHEN a<b-3 THEN 111 WHEN a<=b THEN 222
      WHEN a<b+3 THEN 333 ELSE 444 END
      FROM t1;
  - name: t1

outputs:
  - name: q557.out
    data: |
      107	0	333
      127	0	222
      132	0	333
      137	0	222
      142	0	222
      162	0	444
      172	0	444
      182	0	333
