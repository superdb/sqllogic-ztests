# Failed due to: https://github.com/superdb/super/issues/6549
script: |
  super -i parquet -f tsv -I q452.sql | sort > q452.out

inputs:
  - name: q452.sql
    data: |
      SELECT abs(b-c),
      CASE a+1 WHEN b THEN 111 WHEN c THEN 222
      WHEN d THEN 333  WHEN e THEN 444 ELSE 555 END,
      (SELECT count(*) FROM t1 AS x WHERE x.b<t1.b),
      a+b*2+c*3+d*4,
      b-c,
      d,
      (SELECT count(*) FROM t1 AS x WHERE x.c>t1.c AND x.d<t1.d)
      FROM t1
      WHERE (e>c OR e<d)
      AND coalesce(a,b,c,d,e)<>0
      AND e+d BETWEEN a+b-10 AND c+130;
  - name: t1

outputs:
  - name: q452.out
    data: |
      1	333	0	1067	-1	108	0
      4	333	3	1272	4	128	0
